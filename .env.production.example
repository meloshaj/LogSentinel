# ==========================================
# Core Deployment Configuration
# ==========================================
ENVIRONMENT=production
# Update DOMAIN_NAME to your actual domain name if you configure DNS. 
# Using the Public IP as a placeholder for now.
DOMAIN_NAME=138.2.152.189
# If using HTTPS via Caddy with a real domain, change this to https://yourdomain.com
FRONTEND_URL=http://138.2.152.189

# ==========================================
# Security & Auth
# ==========================================
# Run `python scripts/generate_secrets.py` to generate secure values for these fields.
JWT_SECRET_KEY=<generate_with_scripts_generate_secrets>
ENCRYPTION_KEY=<generate_with_scripts_generate_secrets>
INGEST_API_KEYS=default:<generate_with_scripts_generate_secrets>

# ==========================================
# Backend Configuration
# ==========================================
# --- Database Credentials ---
POSTGRES_USER=logsentinel
POSTGRES_PASSWORD=<generate_with_scripts_generate_secrets>
POSTGRES_DB=logsentinel_db
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# --- Valkey / Redis Configuration ---
REDIS_URL=redis://valkey:6379/0

# --- Drain3 state ---
DRAIN3_STATE_PATH=/app/app/state/drain3_state.bin
DRAIN3_STATE_BACKEND=file

# --- Valkey Stream & Consumer Group ---
LOG_STREAM_NAME=logs:stream
LOG_WORKERS_GROUP=log_workers

# --- Hot/Cold Archive Architecture (S3 / Backblaze B2) ---
# Fill these with your actual Object Storage credentials if you use archival.
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
S3_BUCKET_NAME=logsentinel-archive
S3_BACKUP_BUCKET=
S3_ACCESS_KEY_ID=your_b2_key_id
S3_SECRET_ACCESS_KEY=your_b2_application_key
S3_REGION=us-east-005

# --- Production logical backup execution ---
# Existing host recovery-point directory; Compose mounts it at /backups and
# requires remote upload by default.
BACKUP_HOST_DIR=/home/ubuntu/logsentinel-database-backups
BACKUP_UID=1001
BACKUP_GID=1001
BACKUP_CLEANUP_ENABLED=false
BACKUP_RETENTION_DAYS=
REQUIRE_REMOTE_BACKUP=true

# --- PostgreSQL PITR / remote WAL recovery ---
# WAL and physical-base objects reuse the configured S3-compatible storage by
# default but remain separated by logical prefixes. Set dedicated buckets only
# when the provider policy requires them. Never commit the credential values.
S3_WAL_BUCKET=
S3_WAL_ENDPOINT=
S3_WAL_REGION=
S3_WAL_PREFIX=logsentinel/wal/
S3_WAL_ACCESS_KEY_ID=
S3_WAL_SECRET_ACCESS_KEY=
S3_BASE_BUCKET=
S3_BASE_ENDPOINT=
S3_BASE_REGION=
S3_BASE_PREFIX=logsentinel/pitr-base/
S3_BASE_ACCESS_KEY_ID=
S3_BASE_SECRET_ACCESS_KEY=
PITR_BASE_BACKUP_HOST_DIR=/home/ubuntu/logsentinel-pitr-base-backups
PITR_REQUIRED_SERVER_MAJOR=16
PITR_MIN_FREE_BYTES=1073741824

# --- Retention Policies ---
ARCHIVE_HOT_RETENTION_DAYS=30
ARCHIVE_LATENESS_GRACE_HOURS=2

# --- Pipeline & Graph Scoring Configuration ---
DRAIN3_BATCH_SIZE=500
DRAIN3_FLUSH_INTERVAL_SECONDS=5.0
DRAIN3_QUEUE_DRAIN_TIMEOUT_SECONDS=30.0

GRAPH_SCORING_ENABLED=True
GRAPH_SCORING_LOOKBACK_SECONDS=180
GRAPH_SCORING_TIMEOUT_SECONDS=2.0
GRAPH_SCORING_MAX_ANOMALY_EVENTS=500
GRAPH_SCORING_MAX_LOG_RECORDS=5000

# --- Alerting & Webhooks ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Benchmarking Configuration ---
ENABLE_BENCHMARKING_ENDPOINTS=false

# --- Microsoft Entra API Configuration ---
AZURE_CLIENT_ID=3bd029d4-5e9e-40d4-a398-90dabc34a59f
AZURE_TENANT_ID=common
AZURE_REQUIRED_SCOPE=access_as_user
AZURE_ALLOWED_TENANTS=
AZURE_JWKS_TIMEOUT=5.0
AZURE_JWKS_CACHE_TTL=3600

# --- Google Auth API Configuration ---
GOOGLE_CLIENT_ID=your_google_client_id_here

# --- GitHub Auth API Configuration ---
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# Update the callback URL to the public IP / Domain
GITHUB_CALLBACK_URL=https://138.2.152.189.sslip.io/api/auth/callback/github

# ==========================================
# Frontend Configuration (Vite Build Vars)
# ==========================================
VITE_API_URL=https://138.2.152.189.sslip.io
VITE_WS_URL=wss://138.2.152.189.sslip.io/ws/telemetry
VITE_ENABLE_BENCHMARKING=false

# --- Microsoft Entra SPA Configuration ---
VITE_MICROSOFT_AUTH_ENABLED=true
VITE_MICROSOFT_SPA_CLIENT_ID=f605e074-58af-4377-8663-9aaa3de47476
VITE_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
VITE_MICROSOFT_API_SCOPE=api://3bd029d4-5e9e-40d4-a398-90dabc34a59f/access_as_user
# The production SPA callback is served by the redirect bridge through Pages.
VITE_MICROSOFT_REDIRECT_URI=https://logsentinel.pages.dev/auth/callback
VITE_MICROSOFT_POST_LOGOUT_REDIRECT_URI=https://logsentinel.pages.dev/login

# --- Google Auth SPA Configuration ---
VITE_GOOGLE_AUTH_ENABLED=true
VITE_GOOGLE_CLIENT_ID=your_current_google_web_client_id.apps.googleusercontent.com

# --- GitHub Auth SPA Configuration ---
VITE_FEATURE_ENABLE_GITHUB_AUTH=true
