# ==========================================
# Deployment Configuration
# ==========================================
DOMAIN_NAME=logsentinel.example.com
ENVIRONMENT=development

# ==========================================
# Security & Auth
# ==========================================
JWT_SECRET_KEY=your_strong_random_jwt_secret_here
ENCRYPTION_KEY=your_strong_32_byte_base64_encryption_key_here
INGEST_API_KEY=your_ingest_api_key_here
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# ==========================================
# Backend Configuration
# ==========================================
# --- Database Credentials ---
# Use 'timescaledb' for Docker Compose, '127.0.0.1' for host-native development.
POSTGRES_USER=logsentinel
POSTGRES_PASSWORD=logsentinel_secret
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=logsentinel_db
POSTGRES_SSL_MODE=disable

# --- Valkey / Redis Configuration ---
# Use 'redis://valkey:6379/0' for Docker Compose, 'redis://127.0.0.1:6379/0' for host-native development.
REDIS_URL=redis://valkey:6379/0

# --- Drain3 state ---
# The container default is /app/app/state/drain3_state.bin. Override this only
# when mounting a writable persistent directory.
DRAIN3_STATE_PATH=/app/app/state/drain3_state.bin
# Use redis only when shared parser state is required; file is safer for a
# single local/demo worker and avoids making parser import depend on Valkey.
DRAIN3_STATE_BACKEND=file

# --- Valkey Stream & Consumer Group ---
LOG_STREAM_NAME=logs:stream
LOG_WORKERS_GROUP=log_workers

# --- Hot/Cold Archive Architecture ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=logsentinel-archive
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Pipeline & Graph Scoring Configuration ---
DRAIN3_BATCH_SIZE=500
DRAIN3_FLUSH_INTERVAL_SECONDS=5.0
DRAIN3_QUEUE_DRAIN_TIMEOUT_SECONDS=30.0

GRAPH_SCORING_ENABLED=True
GRAPH_SCORING_LOOKBACK_SECONDS=180
GRAPH_SCORING_TIMEOUT_SECONDS=2.0
GRAPH_SCORING_MAX_ANOMALY_EVENTS=500
GRAPH_SCORING_MAX_LOG_RECORDS=5000

# --- Alerting & Webhooks ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Benchmarking Configuration ---
ENABLE_BENCHMARKING_ENDPOINTS=false

# --- Microsoft Entra API Configuration ---
AZURE_CLIENT_ID=your_microsoft_api_app_client_id
AZURE_TENANT_ID=common
AZURE_REQUIRED_SCOPE=access_as_user
AZURE_ALLOWED_TENANTS=
AZURE_JWKS_TIMEOUT=5.0
AZURE_JWKS_CACHE_TTL=3600

# --- Google Auth API Configuration ---
GOOGLE_CLIENT_ID=your_google_client_id_here

# --- GitHub Auth API Configuration ---
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/callback/github

# ==========================================
# Frontend Configuration (Vite Build Vars)
# ==========================================
VITE_API_URL=http://localhost:8000
VITE_ENABLE_BENCHMARKING=false

# --- Microsoft Entra SPA Configuration ---
VITE_MICROSOFT_AUTH_ENABLED=true
VITE_MICROSOFT_SPA_CLIENT_ID=your_microsoft_spa_app_client_id
VITE_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
VITE_MICROSOFT_API_SCOPE=api://your_microsoft_api_app_client_id/access_as_user
VITE_MICROSOFT_REDIRECT_URI=http://localhost:8080/redirect.html
VITE_MICROSOFT_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login

# --- Google Auth SPA Configuration ---
VITE_GOOGLE_AUTH_ENABLED=true
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# --- GitHub Auth SPA Configuration ---
VITE_FEATURE_ENABLE_GITHUB_AUTH=true
