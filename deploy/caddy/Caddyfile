{$DOMAIN_NAME} {
    # Block internal routes from external access
    @internal {
        path /metrics /readiness /docs* /redoc* /openapi.json
    }
    respond @internal 403

    # API endpoints must be handled separately from the SPA file server
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /ingest-log {
        reverse_proxy backend:8000
    }
    handle /v1/* {
        reverse_proxy backend:8000
    }
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # Serve static frontend files (SPA) for any unhandled routes
    handle {
        root * /usr/share/caddy/html
        try_files {path} /index.html
        file_server
    }
}
